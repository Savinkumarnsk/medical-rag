# ── LLM Provider ("gemini" or "openrouter") ──────────────────────────────────
LLM_PROVIDER=gemini
ENABLE_VERIFIER=false

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# ── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=MedicalDocRAG
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── FAISS ────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/faiss_index
RAW_DOCS_PATH=data/raw

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=4
RETRIEVAL_MMR=true
MMR_FETCH_K=10

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── PII Masking ──────────────────────────────────────────────────────────────
ENABLE_PII_MASKING=false

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
